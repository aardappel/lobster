    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>
        <Detect2Chars attribute="Comment" context="LineComment" char="/" char1="/"/>
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="*" beginRegion="comment"/>
        <StringDetect attribute="String" context="TripleString" String="&quot;&quot;&quot;"/>
        <DetectChar attribute="String" context="String" char="&quot;"/>
        <RegExpr attribute="Char" context="#stay" String="'(\\(x[0-9A-Fa-f]{2}|.)|[^'\\])'"/>
        <RegExpr attribute="Keyword" context="FunctionName" String="\b(def|constructor)\b"/>
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Control Flow" context="#stay" String="control"/>
        <keyword attribute="Data Type" context="#stay" String="types"/>
        <keyword attribute="Constant" context="#stay" String="constants"/>
        <keyword attribute="Built-in" context="#stay" String="builtins"/>
        <RegExpr attribute="BaseN" context="#stay" String="\b0x[0-9A-Fa-f]+\b"/>
        <RegExpr attribute="Float" context="#stay" String="\b[0-9]+\.[0-9]*"/>
        <RegExpr attribute="Float" context="#stay" String="\.[0-9]+"/>
        <RegExpr attribute="Decimal" context="#stay" String="\b[0-9]+\b"/>
        <RegExpr attribute="Normal Text" context="#stay" String="[A-Za-z_][A-Za-z0-9_.]*"/>
        <AnyChar attribute="Operator" context="#stay" String="+-*/%=!&lt;&gt;^|&amp;"/>
      </context>
      <context name="FunctionName" attribute="Normal Text" lineEndContext="#pop" fallthroughContext="#pop">
        <DetectSpaces/>
        <RegExpr attribute="Function" context="#pop" String="[A-Za-z_][A-Za-z0-9_]*"/>
      </context>
      <context name="LineComment" attribute="Comment" lineEndContext="#pop"/>
      <context name="BlockComment" attribute="Comment" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" context="BlockComment" char="/" char1="*" beginRegion="comment"/>
        <Detect2Chars attribute="Comment" context="#pop" char="*" char1="/" endRegion="comment"/>
      </context>
      <context name="String" attribute="String" lineEndContext="#pop">
        <RegExpr attribute="Special Char" context="#stay" String="\\(x[0-9A-Fa-f]{2}|.)"/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>
      <context name="TripleString" attribute="String" lineEndContext="#stay">
        <StringDetect attribute="String" context="#pop" String="&quot;&quot;&quot;"/>
      </context>
    </contexts>
